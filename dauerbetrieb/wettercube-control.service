# Raspberry Pi / Linux ohne Docker: Datei nach /etc/systemd/system/ kopieren, Pfad und Benutzer anpassen, dann
#   sudo systemctl daemon-reload && sudo systemctl enable --now wettercube-control
# Dann im Heimnetz: http://<IP des Pi>:8765  (nur zum Ansehen: Wetterwand, Verlauf, Uebersicht)
[Unit]
Description=WetterCube Control (nur Ansehen)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/wettercube-control
ExecStart=/usr/bin/python3 /home/pi/wettercube-control/control.py --lan
Restart=on-failure

[Install]
WantedBy=multi-user.target
